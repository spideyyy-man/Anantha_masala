# ==============================================================================
# Madurai Aanandha Masala — Environment Configuration Template
# Copy to .env.local and fill real values for staging/production.
# NEVER commit .env.local or real secrets to version control.
# ==============================================================================

# Public canonical URL (used for SEO metadata, sitemap, canonical tags, CSRF check)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database: Managed PostgreSQL connection string for staging/production.
# When omitted in local development, the app automatically uses embedded PostgreSQL (PGlite) in .data/pglite.
# DATABASE_URL=postgresql://user:password@host:5432/aanandha_masala?sslmode=require

# Payment Gateway (Razorpay — optional; falls back to clearly-labeled Sandbox Verification Mode when unset)
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
# RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx

# Sandbox Webhook HMAC Secret (used for cryptographically verifying sandbox payment webhooks in dev/test)
SANDBOX_WEBHOOK_SECRET=dev-local-sandbox-webhook-secret-change-in-prod

# Admin bootstrap credentials (override in production; never use defaults in live deployments)
# ADMIN_BOOTSTRAP_EMAIL=admin@aanandhamasala.in
# ADMIN_BOOTSTRAP_PASSWORD=change-this-strong-password-min-12-chars
# ADMIN_MFA_SECRET=change-this-mfa-secret

# Optional Official Social APIs (server-side only; never prefix with NEXT_PUBLIC_)
# INSTAGRAM_GRAPH_ACCESS_TOKEN=
# YOUTUBE_DATA_API_KEY=
